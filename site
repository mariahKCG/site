:root {
  --plum: #2a1f2d;
  --champagne: #f2e8dd;
  --sand: #d9c7b8;
  --rose: #cfa8a0;
  --gold: #b59a6a;
  --cocoa: #3a2f2a;
  --white: #ffffff;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Inter", sans-serif;
  color: var(--cocoa);
  background: var(--champagne);
  line-height: 1.6;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

.container {
  width: min(1100px, 92%);
  margin: 0 auto;
}

.site-header {
  background: var(--plum);
  color: var(--champagne);
  position: sticky;
  top: 0;
  z-index: 10;
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
}

.brand {
  font-family: "Playfair Display", serif;
  font-size: 1.2rem;
  letter-spacing: 0.06em;
}

.nav-links a {
  margin-left: 18px;
  font-size: 0.95rem;
  opacity: 0.9;
}

.nav-links a.active,
.nav-links a:hover {
  opacity: 1;
  color: var(--gold);
}

.hero {
  padding: 70px 0 40px;
  background: linear-gradient(180deg, rgba(42, 31, 45, 0.04), transparent);
}

.hero-grid {
  display: grid;
  gap: 32px;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  align-items: center;
}

h1,
h2,
h3 {
  font-family: "Playfair Display", serif;
  color: var(--plum);
}

h1 {
  font-size: clamp(2.2rem, 4vw, 3.4rem);
  margin: 10px 0 14px;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.2em;
  font-size: 0.75rem;
  color: var(--gold);
  margin: 0 0 6px;
}

.lead {
  font-size: 1.1rem;
}

.cta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin: 22px 0;
}

.button {
  padding: 12px 22px;
  border-radius: 28px;
  border: 1px solid var(--plum);
  font-weight: 500;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.button.primary {
  background: var(--plum);
  color: var(--champagne);
  border-color: var(--plum);
}

.button.ghost {
  background: transparent;
  color: var(--plum);
}

.button:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 20px rgba(42, 31, 45, 0.12);
}

.note {
  font-size: 0.95rem;
}

.card {
  background: var(--white);
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 20px 40px rgba(42, 31, 45, 0.12);
}

.book-card {
  display: grid;
  gap: 18px;
}

.book-cover {
  border-radius: 16px;
  border: 1px solid rgba(42, 31, 45, 0.15);
}

.section {
  padding: 60px 0;
}

.section.alt {
  background: var(--sand);
}

.subhead {
  max-width: 620px;
}

.grid-4 {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  margin-top: 20px;
}

.pill {
  background: var(--white);
  padding: 16px;
  border-radius: 18px;
  border: 1px solid rgba(42, 31, 45, 0.08);
}

.modules {
  display: grid;
  gap: 20px;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  margin: 28px 0;
}

.module {
  background: var(--white);
  padding: 18px;
  border-radius: 18px;
  border: 1px solid rgba(42, 31, 45, 0.08);
}

.quotes {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
}

blockquote {
  background: var(--white);
  padding: 18px;
  border-radius: 18px;
  border-left: 4px solid var(--gold);
  margin: 0;
  font-style: italic;
}

.cta {
  background: var(--plum);
  color: var(--champagne);
}

.cta h2 {
  color: var(--champagne);
}

.cta .button.primary {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--plum);
}

.cta .button.ghost {
  border-color: var(--champagne);
  color: var(--champagne);
}

.site-footer {
  background: var(--plum);
  color: var(--champagne);
  padding: 24px 0;
  font-size: 0.9rem;
}

.page-hero {
  padding: 60px 0 30px;
}

.page-hero p {
  max-width: 700px;
}

.simple-grid {
  display: grid;
  gap: 24px;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
}

.link-card {
  background: var(--white);
  padding: 24px;
  border-radius: 18px;
  border: 1px solid rgba(42, 31, 45, 0.1);
}

.link-card a {
  color: var(--plum);
  font-weight: 600;
}

.contact-list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.contact-list li {
  margin-bottom: 10px;
}

@media (max-width: 720px) {
  .nav {
    flex-direction: column;
    gap: 12px;
  }
  .nav-links a {
    margin-left: 0;
    margin-right: 12px;
  }
}

